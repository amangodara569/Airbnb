<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/animations.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
</head>
<body style="background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 100%); min-height: 100vh;">
    <!-- this is our layout and we will be requiring it in our other templates -->
     <!-- includeing navbar -->
    <%- include("../includes/navbar.ejs") %>
     <div class="container-fluid" style="padding: 0; margin: 0;">
        <!-- include flash messages -->
        <%- include("../includes/flash.ejs") %>
         <!-- this is where the content of the other templates will be rendered, like index.ejs, show.ejs, etc. -->
         <!-- we will be using ejs layout to render the content of the other templates in this boilerplate template, so that we don't have to repeat the same code in every template, we can just include this boilerplate template in our other templates and then write the content of the other templates in the body section of this boilerplate template, so that it will be rendered in this boilerplate template and we can use the same navbar and footer for all the templates. -->
        <%- body %>
     </div>

     <!-- footer -->
    <%- include("../includes/footer.ejs") %>
    
    <!-- Wave Background Animation -->
    <div class="wave-container">
        <div class="wave"></div>
        <div class="wave"></div>
        <div class="wave"></div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="/js/script.js"></script>
</body>
</html>

<!-- boilerplate ke alag alag parts ko store krne ke liye includes hai like navbar and footer -->